# Claude Configuration
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI Configuration (if used for evaluation)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini Configuration (for API Metadata Analyzer)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Application Configuration
APIS_CONFIG_FILE=config/apis.txt
PROMPTS_CONFIG_FILE=config/prompts.txt
RESULTS_DIR=results

# Claude SDK Configuration
CLAUDE_TIMEOUT_SECONDS=180
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Evaluation Configuration
DEBUG_MODE=false

# ============================================================================
# API Metadata Analyzer Configuration
# ============================================================================

# Default LLM provider for API analysis
# Options: gemini-2.0-flash, gpt-4o-mini, claude-3.5-sonnet
DEFAULT_LLM_PROVIDER=gemini-2.0-flash

# Confidence threshold for accepting LLM assessments (0.0-1.0)
CONFIDENCE_THRESHOLD=0.7

# HTTP request timeout in seconds
TIMEOUT_SECONDS=30

# Maximum number of retries for failed requests
MAX_RETRIES=3

# Enable Verbose logging (optional)
VERBOSE=false

# Enable integration tests with real LLM calls (optional)
# WARNING: Setting this to true will make real API calls that cost money!
ENABLE_LLM_TESTS=false
